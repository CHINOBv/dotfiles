{
  "theme.name": "catppuccin_mocha",
  "theme.matugen": false,
  
  "theme.bar.transparent": true,
  "theme.bar.floating": true,
  "theme.bar.margin_top": "8",
  "theme.bar.margin_sides": "20",
  "theme.bar.border_radius": "20px",
  
  "theme.font.name": "JetBrainsMono Nerd Font",
  "theme.font.size": "12px",
  
  "bar.layouts": {
    "*": {
      "left": ["workspaces"],
      "middle": ["clock"],
      "right": ["volume", "battery", "notifications"]
    }
  },
  
  "bar.workspaces.show_numbered": true,
  "bar.workspaces.showWsIcons": false,
  "bar.workspaces.numbered_active_indicator": "highlight",
  "bar.workspaces.workspaces": 5,
  "bar.workspaces.hideUnoccupied": true,
  
  "bar.clock.format": "%H:%M",
  "bar.clock.showIcon": false,
  
  "bar.volume.label": false,
  "bar.battery.label": false,
  
  "bar.notifications.show_total": false,
  "bar.notifications.hideCountWhenZero": true,
  
  "menus.clock.weather.enabled": false,
  "scalingPriority": "hyprland"
}
