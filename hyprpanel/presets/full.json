{
  "theme.name": "catppuccin_mocha",
  "theme.matugen": false,
  
  "theme.bar.transparent": true,
  "theme.bar.floating": true,
  "theme.bar.margin_top": "8",
  "theme.bar.margin_sides": "15",
  "theme.bar.border_radius": "16px",
  
  "theme.font.name": "JetBrainsMono Nerd Font",
  "theme.font.size": "13px",
  
  "bar.layouts": {
    "*": {
      "left": ["dashboard", "workspaces", "windowtitle"],
      "middle": ["media", "clock"],
      "right": ["cpu", "ram", "systray", "volume", "bluetooth", "network", "battery", "notifications"]
    }
  },
  
  "bar.launcher.icon": "󰣇",
  "bar.launcher.autoDetectIcon": false,
  
  "bar.workspaces.show_numbered": true,
  "bar.workspaces.showWsIcons": false,
  "bar.workspaces.numbered_active_indicator": "highlight",
  "bar.workspaces.workspaces": 5,
  "bar.workspaces.hideUnoccupied": false,
  
  "bar.windowtitle.label": true,
  "bar.windowtitle.truncation_size": 30,
  
  "bar.clock.format": "%H:%M  %a %d %b",
  "bar.clock.showIcon": true,
  "bar.clock.icon": "",
  
  "bar.media.show_artist": true,
  "bar.media.show_label": true,
  "bar.media.truncation_size": 25,
  
  "bar.volume.label": true,
  "bar.network.label": true,
  "bar.bluetooth.label": false,
  "bar.battery.label": true,
  
  "bar.customModules.cpu.label": true,
  "bar.customModules.ram.label": true,
  
  "bar.notifications.show_total": true,
  "bar.notifications.hideCountWhenZero": true,
  
  "menus.clock.weather.enabled": false,
  "menus.dashboard.powermenu.confirmation": true,
  "menus.dashboard.shortcuts.enabled": true,
  "menus.dashboard.directories.enabled": true,
  
  "scalingPriority": "hyprland"
}
