#!/usr/bin/env bash
# AI Commit Message Generator using OpenCode with Claude Haiku
# Generates detailed, senior-level commit messages following Git Flow

set -e

# Get the staged diff
DIFF=$(git diff --cached --no-color | head -c 6000)

if [ -z "$DIFF" ]; then
    echo "No staged changes found. Stage your changes first with 'git add'"
    exit 1
fi

# Get context
BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
STAGED_FILES=$(git diff --cached --name-only | tr '\n' ', ' | sed 's/,$//')

# Use OpenCode with Haiku model
~/.opencode/bin/opencode run --model anthropic/claude-haiku-4-5 "You are a Senior Software Engineer writing a detailed git commit message.

## Commit Format
<type>(<scope>): <concise summary in imperative mood>

<detailed body explaining:>
- What was changed and why
- Technical decisions made
- Impact on the codebase

## Types
- feat: New feature
- fix: Bug fix
- refactor: Code restructuring without behavior change
- perf: Performance improvement
- docs: Documentation
- test: Tests
- chore: Maintenance tasks
- ci: CI/CD changes
- style: Code style/formatting

## Rules
1. Title: max 50 chars, imperative mood (Add, Fix, Update, Refactor)
2. Body: detailed technical explanation, wrapped at 72 chars
3. Explain the WHY, not just the what
4. Mention affected components/modules
5. Be specific - a senior dev should understand the full context
6. Output ONLY the commit message - no markdown, no explanations, no quotes

## Context
Branch: $BRANCH
Files changed: $STAGED_FILES

## Diff
$DIFF" 2>/dev/null
